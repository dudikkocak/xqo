# --- on the HQ (.env next to its docker-compose.yml, or exported before `xqo serve`) ---
# one token per worker; make each with: xqo flows token
XQO_WORKER_GPU_BOX_TOKEN=paste-a-token-here
XQO_WORKER_MAC_MINI_TOKEN=paste-another-token-here
# the secret of plan-and-build's webhook trigger (GitHub: the webhook's "Secret"); make it with: xqo flows token
FLOW_PLAN_BUILD_SECRET=paste-a-webhook-secret-here

# --- on the worker ---
# the same token as XQO_WORKER_GPU_BOX_TOKEN on the HQ
XQO_WORKER_TOKEN=paste-the-same-token-here
# the worker's own model access
ANTHROPIC_API_KEY=
